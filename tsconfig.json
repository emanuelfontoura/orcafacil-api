{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "resolveJsonModule": true,

    "types": ["node"],
   
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests", "prisma.config.ts"],
  "exclude": ["node_modules"]
}